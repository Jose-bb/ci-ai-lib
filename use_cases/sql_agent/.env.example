# Global configuration
LLM_PROVIDER=azure_openai

# Azure OpenAI configuration
AZURE_OPENAI_API_KEY=your_azure_api_key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2023-12-01-preview
AZURE_OPENAI_MODEL=the_model

# Gemini configuration
GEMINI_API_KEY=your_gemini_api_key

# PostgreSQL Connection (For SQL Agent CRM)
POSTGRES_CRM_URI="postgresql+psycopg2://admin:admin@host.docker.internal:5432/crm_db"

# MongoDB Connection (For NoSQL Agent)
MONGODB_URI="mongodb://host.docker.internal:27017/"

# Redis Connection (For LangGraph Memory/Checkpointer)
REDIS_HOST=host.docker.internal
